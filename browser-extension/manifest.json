{
  "manifest_version": 3,
  "name": "Send to Deck Factory",
  "version": "0.1.0",
  "description": "One click to send your selected Midjourney images straight into the Deck Factory import pipeline.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.midjourney.com/*",
    "https://cdn.midjourney.com/*",
    "https://imageforge-q125.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Deck Factory settings"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.midjourney.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
