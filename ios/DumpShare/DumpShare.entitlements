<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Matches the host app's group: files are staged here so the system's
       upload daemon can still read them after the share sheet dismisses. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.sageryza.imageforge</string>
  </array>
</dict>
</plist>
