<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Same group as the app and DumpShare: this is how the widget reads the
       server URL and studio token the app writes at launch. A widget
       extension has its own container and cannot see the app's UserDefaults. -->
  <key>com.apple.security.application-groups</key>
  <array>
    <string>group.com.sageryza.imageforge</string>
  </array>
</dict>
</plist>
