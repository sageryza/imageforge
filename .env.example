# Copy to .env for local dev (.env is gitignored). Never commit real values.

# Required for text generation (entries, moments, subjects) and DALL·E images
OPENAI_API_KEY=

# Required for the Replicate (custom LoRA) illustration styles
REPLICATE_API_TOKEN=

# Optional: Firebase service account JSON (single line) to permanently save
# generated images and power the gallery. Without it, images use temporary URLs.
FIREBASE_SERVICE_ACCOUNT=

# ── Product pipeline: Etsy + POD services ──────────────────────────────
# All the keys below can either be set here / as host env vars, OR stored in a
# single Firestore doc (default "config/pipeline") that the server reads at boot
# via config-loader.js. Host env vars always win over Firestore. Populate the
# Firestore doc with: node scripts/set-pipeline-keys.js (needs the service
# account + the keys in the environment). Override the doc with:
# PIPELINE_CONFIG_DOC=config/imageforge
#
# Etsy Open API v3. Both required for the /api/etsy routes. App-level reads
# send "x-api-key: <KEY>:<SHARED_SECRET>"; writes use OAuth 2.0.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
# Optional: OAuth callback. Must match a redirect URI registered on the Etsy
# app. Defaults to <RENDER_EXTERNAL_URL>/api/etsy/callback, else localhost.
ETSY_REDIRECT_URI=

# Printify (POD — wide catalog / lower cost). Personal Access Token (a JWT).
PRINTIFY_API_KEY=
# Optional: pin a shop id (else the first shop is used).
PRINTIFY_SHOP_ID=

# Printful (POD — in-house quality apparel / greeting cards). Account token.
PRINTFUL_API_KEY=
# Optional: pin a store id (sent as X-PF-Store-Id).
PRINTFUL_STORE_ID=

# Lulu (POD — books / coloring books). OAuth2 client-credentials. Either set
# the two pieces (LULU_API_KEY + LULU_API_SECRET), OR paste the single
# pre-encoded base64(key:secret) string from Lulu's dashboard as LULU_BASE64.
LULU_API_KEY=
LULU_API_SECRET=
LULU_BASE64=
# Optional: set LULU_SANDBOX=1 to target the sandbox, or LULU_API_BASE to override.
LULU_SANDBOX=

# Midjourney deck-art generator via APIFRAME (/api/apiframe). Midjourney has no
# official API; APIFRAME runs its own MJ accounts and exposes a REST API, so no
# personal Midjourney account is involved. Get the key at https://console.apiframe.ai.
APIFRAME_KEY=

# MakePlayingCards full auto-upload (/api/mpc-upload). The MPC account the
# headless browser signs into to build the deck project + reach the cart
# (it always STOPS before payment). Needs a browser-capable host (Playwright +
# Chromium) — not the Render free web service. Leave unset to keep the ZIP
# hand-off (/api/mpc/prep-order) as the only path.
MPC_EMAIL=
MPC_PASSWORD=
# Optional overrides for the login / deck-product URLs and, on hosts where the
# browser lives outside Playwright's cache, the Chromium executable path.
MPC_LOGIN_URL=
MPC_PRODUCT_URL=
MPC_BROWSER_PATH=

# Brevo (tap-to-reveal Card of the Day email, /api/tarot-email). API key from
# app.brevo.com → SMTP & API. The from-address must be a sender verified in
# Brevo; the name defaults to "Secretly a Witch".
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=

# Optional: gate the Studio + its mutating/costly API routes. When set, /studio
# requires this as an HTTP Basic password (any username) and the API requires it
# as the x-studio-token header (the page sends it automatically). Unset = open.
STUDIO_TOKEN=

# Optional: defaults to 3001 (Render sets this automatically)
PORT=3001
